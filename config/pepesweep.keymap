#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define NAV_L 1
#define NUM_L 2
#define SYM_L 3
#define ZMK_L 4

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace

&lt { quick_tap_ms = <200>; };

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 3>;
            layers = <0>;
            bindings = <&kp ESC>;
        };

        combo_del {
            timeout-ms = <50>;
            key-positions = <20 21 8 11>;
            layers = <0>;
            bindings = <&kp DEL>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <21 23 11 9>;
            layers = <0>;
            bindings = <&kp TAB>;
        };

        combo_underscore {
            timeout-ms = <50>;
            key-positions = <26 28 12 14>;
            layers = <0>;
            bindings = <&kp UNDER>;
        };

        combo_left_curly_bracket {
            timeout-ms = <50>;
            key-positions = <1 9>;
            layers = <0>;
            bindings = <&kp LBRC>;  // {
        };

        combo_left_parenthesis {
            timeout-ms = <50>;
            key-positions = <3 11>;
            layers = <0>;
            bindings = <&kp LPAR>;  // (
        };

        combo_left_square_bracket {
            timeout-ms = <50>;
            key-positions = <2 10>;
            layers = <0>;
            bindings = <&kp LBKT>;  // [
        };

        combo_right_curly_bracket {
            timeout-ms = <50>;
            key-positions = <6 14>;
            layers = <0>;
            bindings = <&kp RBRC>;  // }
        };

        combo_right_parenthesis {
            timeout-ms = <50>;
            key-positions = <4 12>;
            layers = <0>;
            bindings = <&kp RPAR>;  // )
        };

        combo_right_square_bracket {
            timeout-ms = <50>;
            key-positions = <5 13>;
            layers = <0>;
            bindings = <&kp RBKT>;  // ]
        };

        combo_left_angle_brackent {
            bindings = <&kp LESS_THAN>;
            layers = <0>;
            key-positions = <0 8>;
        };

        combo_right_angle_brackent {
            bindings = <&kp GREATER_THAN>;
            layers = <0>;
            key-positions = <7 15>;
        };

        combo_w {
            bindings = <&kp W>;
            layers = <0>;
            key-positions = <0 1>;
        };

        combo_p {
            bindings = <&kp P>;
            layers = <0>;
            key-positions = <1 2>;
        };

        combo_b {
            bindings = <&kp B>;
            layers = <0>;
            key-positions = <2 3>;
        };

        combo_f {
            bindings = <&kp F>;
            layers = <0>;
            key-positions = <3 4>;
        };

        combo_q {
            bindings = <&kp Q>;
            layers = <0>;
            key-positions = <4 5>;
        };

        combo_comma {
            bindings = <&kp COMMA>;
            layers = <0>;
            key-positions = <5 6>;
        };

        combo_dot {
            bindings = <&kp DOT>;
            layers = <0>;
            key-positions = <6 7>;
        };

        combo_g {
            bindings = <&kp G>;
            layers = <0>;
            key-positions = <9 10>;
        };

        combo_k {
            bindings = <&kp K>;
            layers = <0>;
            key-positions = <10 11>;
        };

        combo_j {
            bindings = <&kp J>;
            layers = <0>;
            key-positions = <11 12>;
        };

        combo_x {
            bindings = <&kp X>;
            layers = <0>;
            key-positions = <12 13>;
        };

        combo_z {
            bindings = <&kp Z>;
            layers = <0>;
            key-positions = <13 14>;
        };

        // Num Layer
        combo_exclamation_mark {
            bindings = <&kp EXCL>;
            layers = <2>;
            key-positions = <0 3>;
        };
        combo_right_parathesis_num_lay {
            bindings = <&kp RPAR>;
            layers = <2>;
            key-positions = <4 7>;
        };
        combo_1 {
            bindings = <&kp N0>;
            layers = <2>;
            key-positions = <8 11>;
        };
        combo_0 {
            bindings = <&kp N0>;
            layers = <2>;
            key-positions = <12 15>;
        };
    };
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "homerow mods";
            #binding-cells = <2>;
            tapping_term_ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
  &hm LGUI R  &hm LSHFT S  &hm LALT T  &hm LCTRL H       &hm RCTRL N  &hm LALT A  &hm RSHFT I  &hm RGUI O
  &kp V       &kp C        &kp D       &kp M             &kp L        &kp U       &kp Y        &kp SQT
                   &mt LSHFT BSPC  &lt SYM_L SPACE       &lt NUM_L E  &lt NAV_L RET
            >;
        };

        nav_layer {
            bindings = <
  &kp F1  &kp F2  &kp F3  &kp F4        &kp HOME  &kp PG_UP   &kp END    &kp C_VOL_UP
  &kp F5  &kp F6  &kp F7  &kp F8        &kp LEFT  &kp DOWN    &kp RIGHT  &kp C_VOL_DOWN
                  &trans  &trans        &trans    &trans
            >;
        };

        num_layer {
            bindings = <
  &kp AT  &kp DQT  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS  &kp STAR  &kp LPAR
  &kp N2  &kp N3   &kp N4    &kp N5       &kp N6     &kp N7    &kp N8    &kp N9
                   &trans    &trans       &trans     &trans
            >;
        };

        sym_layer {
            bindings = <
  &kp EXCL  &kp AT    &kp LS(N3)  &kp DLLR   &kp PRCNT  &kp CARET  &kp AMPS   &kp STAR
  &kp LPAR  &kp RPAR  &kp LBRC    &kp LBKT   &kp LPAR   &kp MINUS  &kp GRAVE  &kp NON_US_HASH
                   &trans    &trans       &trans     &trans
            >;
        };

        zmk_layer {
            // https://zmk.dev/docs/behaviors/bluetooth
            // https://zmk.dev/docs/behaviors/outputs
            // https://zmk.dev/docs/behaviors/reset

            bindings = <
  &bt BT_CLR    &out OUT_BLE  &out OUT_USB  &sys_reset      &bootloader   &bootloader   &sys_reset    &out OUT_USB
  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4  &bt BT_SEL 5  &bt BT_SEL 6  &bt BT_SEL 7
                              &trans        &trans          &trans &trans
            >;
        };
    };
};
