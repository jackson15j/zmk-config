#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define NAV_L 1
#define NUM_L 2
#define SYM_L 3
#define ZMK_L 4

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace

&lt { quick_tap_ms = <200>; };

/// Combo's function to flatten the below structure.
/// https://github.com/caksoylar/zmk-config/blob/main/config/includes/combos.dtsi
#define COMBO(NAME, BINDINGS, KEYPOS, LAYERS, TERM, QUICKTAP, ...) \
    combo_##NAME { \
        timeout-ms = <TERM>; \
        bindings = <BINDINGS>; \
        key-positions = <KEYPOS>; \
        layers = <LAYERS>; \
        require-prior-idle-ms = <QUICKTAP>; \
        __VA_ARGS__ \
    };

/ {
    combos {
        compatible = "zmk,combos";
        // COMBO(NAME,              BINDINGS,          KEYPOS, LAYERS, TERM, QUICKTAP)
		// Default Layer
        COMBO(esc,                  &kp ESC,           0 3,    0,      50,  0)
        COMBO(del,                  &kp DEL,           8 11,   0,      50,  0)
        COMBO(tab,                  &kp TAB,           9 11,   0,      50,  0)
        COMBO(underscore,           &kp UNDER,         12 14,  0,      50,  0)
        COMBO(left_curly_bracket,   &kp LBRC,          1 9,    0,      50,  0)
        COMBO(left_parenthesis,     &kp LPAR,          3 11,   0,      50,  0)
        COMBO(left_square_bracket,  &kp LBKT,          2 10,   0,      50,  0)
        COMBO(right_curly_bracket,  &kp RBRC,          6 14,   0,      50,  0)
        COMBO(right_parenthesis,    &kp RPAR,          4 12,   0,      50,  0)
        COMBO(right_square_bracket, &kp RBKT,          5 13,   0,      50,  0)
        COMBO(left_angle_brackent,  &kp LESS_THAN,     0 8,    0,      50,  0)
        COMBO(right_angle_brackent, &kp GREATER_THAN,  7 15,   0,      50,  0)
        COMBO(w,                    &kp W,             0 1,    0,      50,  0)
        COMBO(p,                    &kp P,             1 2,    0,      50,  0)
        COMBO(b,                    &kp B,             2 3,    0,      50,  0)
        COMBO(f,                    &kp F,             3 4,    0,      50,  0)
        COMBO(q,                    &kp Q,             4 5,    0,      50,  0)
        COMBO(comma,                &kp COMMA,         5 6,    0,      50,  0)
        COMBO(dot,                  &kp DOT,           6 7,    0,      50,  0)
        COMBO(g,                    &kp G,             9 10,   0,      50,  0)
        COMBO(k,                    &kp K,             10 11,  0,      50,  0)
        COMBO(j,                    &kp J,             11 12,  0,      50,  0)
        COMBO(x,                    &kp X,             12 13,  0,      50,  0)
        COMBO(z,                    &kp Z,             13 14,  0,      50,  0)
        COMBO(caps_word,            &caps_word,        2 5,    0,      50,  0)
        COMBO(sticky_ctrl,          &sk LCTRL,         4 7,    0,      50,  0)

        // Num Layer
        COMBO(exclamation_mark,         &kp EXCL,      0 3,    2,      50,  0)
        COMBO(right_parathesis_num_lay, &kp RPAR,      4 7,    2,      50,  0)
        COMBO(1,                        &kp N1,        8 11,   2,      50,  0)
        COMBO(0,                        &kp N0,        12 15,  2,      50,  0)
    };
};

// Stay capitalised on underscore/minus in a word.
&caps_word {
    continue-list = <UNDERSCORE MINUS>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "homerow mods";
            #binding-cells = <2>;
            tapping_term_ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
  &hm LGUI R  &hm LSHFT S  &hm LALT T  &hm LCTRL H       &hm RCTRL N  &hm LALT A  &hm RSHFT I  &hm RGUI O
  &lt ZMK_L V &kp C        &kp D       &kp M             &kp L        &kp U       &kp Y        &lt ZMK_L SQT
                   &mt LSHFT BSPC  &lt SYM_L SPACE       &lt NUM_L E  &lt NAV_L RET
            >;
        };

        nav_layer {
            display-name = "Navigation";
            bindings = <
  &kp F1  &kp F2  &kp F3  &kp F4        &kp HOME  &kp UP    &kp END    &kp C_VOL_UP
  &kp F5  &kp F6  &kp F7  &kp F8        &kp LEFT  &kp DOWN  &kp RIGHT  &kp C_VOL_DN
                  &trans  &trans        &trans    &trans
            >;
        };

        num_layer {
            display-name = "Numbers";
            bindings = <
  &kp AT  &kp DQT  &kp DLLR  &kp PRCNT      &kp CARET  &kp AMPS  &kp STAR  &kp LPAR
  &kp N2  &kp N3   &kp N4    &kp N5         &kp N6     &kp N7    &kp N8    &kp N9
                   &trans    &trans         &trans     &trans
            >;
        };

        sym_layer {
            display-name = "Symbols";
            bindings = <
  &kp EXCL  &kp PLUS  &kp MINUS  &kp NON_US_BSLH     &kp LA(N3)  &kp UNDER  &kp DKT    &kp STAR
  &kp AT    &kp FSLH  &kp BSLH   &kp SQT             &kp PIPE2   &kp FSLH   &kp EQUAL  &kp QMARK
                      &trans     &trans              &trans      &trans
            >;
        };

        zmk_layer {
            // https://zmk.dev/docs/behaviors/bluetooth
            // https://zmk.dev/docs/behaviors/outputs
            // https://zmk.dev/docs/behaviors/reset

            display-name = "ZMK";
            bindings = <
  &bt BT_CLR  &out OUT_BLE  &out OUT_USB  &sys_reset        &sys_reset    &bootloader   &sys_reset    &out OUT_USB
  &trans      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 5  &trans
                            &trans        &trans            &trans        &trans
            >;
        };
    };
};
